#!/bin/bash
####################################
# JOB INFO: parallel, single node

#SBATCH --job-name=pickling_minit3D
#SBATCH --output=outputs/pickling_minit3D_%A.out  
#SBATCH --nodes=1      
#SBATCH --ntasks=40                
#SBATCH --time=48:00:00 
#SBATCH --mail-type=begin        
#SBATCH --mail-type=fail
#SBATCH --mail-type=end       
#SBATCH --mail-user=celora@ice.csic.es


module load conda/py3-latest
# I get warnings to use 'conda deactivate' instead but that doesn't work
source deactivate 
conda activate myenv


python3 -u pickling_minit3D.py config_pickling_minit3D.txt